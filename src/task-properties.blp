using Gtk 4.0;
using GtkSource 5;
using Adw 1;

template $ErrandsTaskProperties: Adw.Bin {
  Adw.ToolbarView {
    [bottom]
    Adw.ViewSwitcher {
      stack: stack;
      policy: narrow;
      halign: center;
      margin-top: 6;
      margin-bottom: 6;
    }

    content: Adw.ViewStack stack {
      Adw.ViewStackPage {
        name: "properties";
        title: _("Properties");
        icon-name: "errands-calendar-symbolic";

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            title: _("Date and Time");

            $ErrandsDateChooser start_date_chooser {
              subtitle: _("Start Date");

              styles [
                "property",
              ]
            }

            $ErrandsDateChooser due_date_chooser {
              subtitle: _("Due Date");
              visible: bind rrule_row.enable-expansion inverted;

              styles [
                "property",
              ]
            }

            $ErrandsRruleRow rrule_row {}
          }

          Adw.PreferencesGroup attachments {
            title: _("Attachments");
          }

          Adw.PreferencesGroup {
            Adw.ButtonRow {
              title: _("Add Attachment");
              start-icon-name: "errands-add-symbolic";
              action-name: "task-properties.add-attachment";
            }
          }
        };
      }

      Adw.ViewStackPage {
        name: "notes";
        title: _("Notes");
        icon-name: "errands-notes-symbolic";

        child: Box {
          orientation: vertical;

          ScrolledWindow {
            propagate-natural-height: true;
            vexpand: true;

            GtkSource.View notes_view {
              top-margin: 6;
              bottom-margin: 6;
              right-margin: 6;
              left-margin: 6;
              wrap-mode: word;

              buffer: GtkSource.Buffer notes_buffer {};
            }
          }

          Separator {}
        };
      }

      Adw.ViewStackPage {
        name: "tags";
        title: _("Tags");
        icon-name: "errands-tag-symbolic";

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            Adw.EntryRow {
              title: _("New Tag");
              entry-activated => $on_tag_entry_activated_cb(template);
            }
          }

          Adw.PreferencesGroup tags {}
        };
      }
    };
  }
}
