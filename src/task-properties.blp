using Gtk 4.0;
using GtkSource 5;
using Adw 1;

template $ErrandsTaskProperties: Adw.Bin {
  Adw.ToolbarView {
    [bottom]
    Adw.ViewSwitcher {
      stack: stack;
      policy: narrow;
      halign: center;
      margin-top: 6;
      margin-bottom: 6;
    }

    content: Adw.ViewStack stack {
      Adw.ViewStackPage {
        name: "properties";
        title: _("Properties");
        icon-name: "errands-calendar-symbolic";

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            title: _("Description");

            header-suffix: Button undo_btn {
              icon-name: "errands-reset-symbolic";
              tooltip-text: _("Undo Changes");
              sensitive: false;
              action-name: "task-properties.undo-description";

              styles [
                "flat",
              ]
            };

            TextView text_view {
              top-margin: 12;
              bottom-margin: 12;
              left-margin: 6;
              right-margin: 6;

              styles [
                "card",
              ]

              buffer: TextBuffer buffer {
                changed => $on_description_changed_cb(template) not-swapped;
              };
            }
          }

          Adw.PreferencesGroup {
            title: _("Date and Time");

            $ErrandsDateChooser start_date_chooser {
              title: _("Start Date");
            }

            $ErrandsDateChooser due_date_chooser {
              title: _("Due Date");
              visible: bind rrule_row.enable-expansion inverted;
            }

            $ErrandsRruleRow rrule_row {}
          }

          Adw.PreferencesGroup {
            title: _("Priority");

            Adw.ComboRow priority {
              title: _("Level");

              model: StringList {
                strings [
                  _("None"),
                  _("Low"),
                  _("Medium"),
                  _("High"),
                ]
              };
            }
          }

          Adw.PreferencesGroup {
            title: _("Color");

            Adw.ActionRow {
              title: _("Task Accent Color");

              [suffix]
              Box {
                spacing: 6;

                styles [
                  "toolbar",
                ]

                Button reset_color_btn {
                  valign: center;
                  icon-name: "errands-reset-symbolic";
                  tooltip-text: _("Clear Color");
                  action-name: "task-properties.clear-color";
                }

                $ErrandsColorButton color {
                  notify::rgba => $on_rgba_changed_cb(template);
                }
              }
            }
          }

          Adw.PreferencesGroup attachments {
            title: _("Attachments");
          }

          Adw.PreferencesGroup {
            Adw.ButtonRow {
              title: _("Add Attachment");
              start-icon-name: "errands-add-symbolic";
              action-name: "task-properties.add-attachment";
            }
          }
        };
      }

      Adw.ViewStackPage {
        name: "notes";
        title: _("Notes");
        icon-name: "errands-notes-symbolic";

        child: Box {
          orientation: vertical;

          ScrolledWindow {
            propagate-natural-height: true;
            vexpand: true;

            GtkSource.View notes_view {
              top-margin: 6;
              bottom-margin: 6;
              right-margin: 6;
              left-margin: 6;
              wrap-mode: word;

              buffer: GtkSource.Buffer notes_buffer {};
            }
          }

          Separator {}
        };
      }

      Adw.ViewStackPage {
        name: "tags";
        title: _("Tags");
        icon-name: "errands-tag-symbolic";

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            Adw.EntryRow {
              title: _("New Tag");
              entry-activated => $on_tag_entry_activated_cb(template);
            }
          }

          Adw.PreferencesGroup tags {}
        };
      }
    };
  }
}
