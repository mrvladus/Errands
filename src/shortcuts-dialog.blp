using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  // General
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Preferences");
      accelerator: "<Control>comma";
    }

    Adw.ShortcutsItem {
      title: _("Open Menu");
      accelerator: "F10";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      accelerator: "<Control>W";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<Control>Q";
    }
  }

  // Task List
  Adw.ShortcutsSection {
    title: _("Task List");

    Adw.ShortcutsItem {
      title: _("Toggle Search");
      accelerator: "<Control>F";
    }
  }

  // Sync
  Adw.ShortcutsSection {
    title: _("Sync");

    Adw.ShortcutsItem {
      title: _("Sync Now");
      accelerator: "<Control><Shift>S";
    }
  }
}
