using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  // General
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Preferences");
      accelerator: "<Control>comma";
    }

    Adw.ShortcutsItem {
      title: _("Open Menu");
      accelerator: "F10";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      accelerator: "<Control>W";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<Control>Q";
    }
  }

  // Task List
  Adw.ShortcutsSection {
    title: _("Task List");

    Adw.ShortcutsItem {
      title: _("Add Task List");
      accelerator: "<Control>L";
    }

    Adw.ShortcutsItem {
      title: _("Toggle Search");
      accelerator: "<Control>F";
    }

    Adw.ShortcutsItem {
      title: _("New Toplevel Task");
      accelerator: "<Control>N";
    }

    Adw.ShortcutsItem {
      title: _("Switch to the next Task List");
      accelerator: "<Control>J";
    }

    Adw.ShortcutsItem {
      title: _("Switch to the previous Task List");
      accelerator: "<Control>K";
    }

    Adw.ShortcutsItem {
      title: _("Toggle sidebar");
      accelerator: "<Control>B";
    }

    Adw.ShortcutsItem {
      title: _("Open Task List Menu");
      accelerator: "<Control>M";
    }

    Adw.ShortcutsItem {
      title: _("Open \"Sort / Filter\" Menu");
      accelerator: "<Control><Shift>F";
    }
  }

  // Sync
  Adw.ShortcutsSection {
    title: _("Sync");

    Adw.ShortcutsItem {
      title: _("Sync Now");
      accelerator: "<Control><Shift>S";
    }
  }
}
