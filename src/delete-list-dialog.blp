using Gtk 4.0;
using Adw 1;

template $ErrandsDeleteListDialog: Adw.AlertDialog {
  default-response: "delete";
  heading: _("Are you sure?");
  response => $on_response_cb();

  responses [
    close: _("Cancel"),
    delete: _("Delete") destructive,
  ]
}
