using Gtk 4.0;
using Adw 1;

template $ErrandsTaskList: Adw.BreakpointBin {
  width-request: 360;
  height-request: 200;

  Adw.Breakpoint {
    condition ("max-width: 610")

    setters {
      sidebar_btn.visible: false;
    }
  }

  Overlay {
    child: Adw.ToolbarView tb_view {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle title {
          title: _("Task List");
          tooltip-text: bind title.subtitle;
        };

        [start]
        ToggleButton sidebar_btn {
          icon-name: "errands-sidebar-left-symbolic";
          tooltip-text: _("Toggle Sidebar (Ctrl+B)");

          ShortcutController {
            scope: global;

            Shortcut {
              trigger: "<Control>B";
              action: "activate";
            }
          }
        }

        [start]
        MenuButton {
          icon-name: "errands-sort-symbolic";
          tooltip-text: _("Sort / Filter (Ctrl+Shift+F)");

          menu-model: menu {
            section {
              label: _("Show Tasks");

              item {
                label: _("Completed");
                action: "task-list.show-completed";
              }

              item {
                label: _("Cancelled");
                action: "task-list.show-cancelled";
              }
            }

            section {
              label: _("Sort Order");

              item {
                label: _("Descending");
                action: "task-list.sort-order";
                target: "desc";
              }

              item {
                label: _("Ascending");
                action: "task-list.sort-order";
                target: "asc";
              }
            }

            section {
              label: _("Sort By");

              item {
                label: _("Created");
                action: "task-list.sort-by";
                target: "created";
              }

              item {
                label: _("Start Date");
                action: "task-list.sort-by";
                target: "start";
              }

              item {
                label: _("Due Date");
                action: "task-list.sort-by";
                target: "due";
              }

              item {
                label: _("Priority");
                action: "task-list.sort-by";
                target: "priority";
              }
            }
          };

          ShortcutController {
            scope: global;

            Shortcut {
              trigger: "<Control><Shift>F";
              action: "activate";
            }
          }
        }

        [end]
        MenuButton menu_btn {
          tooltip-text: _("Task List Menu (Ctrl+M)");
          icon-name: "errands-more-symbolic";
          valign: center;

          menu-model: menu {
            section {
              item (_("Rename List"), "task-list.rename")
            }

            section {
              item (_("Export as \".ics\""), "task-list.export")
              item (_("Print"), "task-list.print")
            }

            section {
              item (_("Delete Completed"), "task-list.delete-completed")
              item (_("Delete Cancelled"), "task-list.delete-cancelled")
            }

            section {
              item (_("Delete List"), "task-list.delete")
            }
          };

          ShortcutController {
            scope: global;

            Shortcut {
              trigger: "<Control>M";
              action: "activate";
            }
          }
        }

        [end]
        ToggleButton search_btn {
          icon-name: "errands-search-symbolic";
          tooltip-text: _("Search (Ctrl+F)");

          ShortcutController {
            scope: global;

            Shortcut {
              trigger: "<Control>F";
              action: "activate";
            }
          }
        }
      }

      [top]
      SearchBar search_bar {
        search-mode-enabled: bind search_btn.active bidirectional;
        key-capture-widget: search_entry;

        SearchEntry search_entry {
          margin-start: 6;
          margin-end: 6;
          hexpand: true;
          search-changed => $on_task_list_search_cb(template);
        }
      }

      content: Adw.OverlaySplitView overlay_split_view {
        sidebar-position: end;
        pin-sidebar: true;
        collapsed: true;
        show-sidebar: false;
        min-sidebar-width: 360;
        max-sidebar-width: 500;
        notify::show-sidebar => $on_show_properties_toggled_cb(template);

        content: Box {
          orientation: vertical;

          Adw.StatusPage {
            title: _("No Tasks");
            icon-name: "errands-select-symbolic";
            vexpand: true;
            visible: bind scrl.visible inverted;
          }

          ScrolledWindow scrl {
            vexpand: true;

            ListView list_view {
              enable-rubberband: false;
              single-click-activate: false;

              factory: SignalListItemFactory {
                setup => $on_setup_item_cb();
                bind => $on_bind_item_cb();
                unbind => $on_unbind_item_cb();
              };

              activate => $on_listview_activate_cb();
            }
          }

          Separator {}

          Box entry_box {
            styles [
              "toolbar",
            ]

            Entry entry {
              placeholder-text: _("Add Task");
              tooltip-text: _("Add Task (Ctrl+N)");
              hexpand: true;
              secondary-icon-name: "errands-question-symbolic";
              secondary-icon-tooltip-markup: _(
                "<b>Inline properties syntax:</b>\n\n<b>##tag</b>  Add tag.\n<b>#pN</b>     Set priority. <b>N</b> is number in range <b>0..9</b>."
              );
              activate => $on_task_list_entry_activated_cb(template);
              changed => $on_task_list_entry_text_changed_cb(template);

              ShortcutController {
                scope: global;

                Shortcut {
                  trigger: "<Control>N";
                  action: "action(task-list.focus-entry)";
                }
              }
            }

            Button entry_apply_btn {
              icon-name: "errands-select-symbolic";
              valign: end;
              tooltip-text: _("Add Task (Ctrl+Return)");
              sensitive: false;
              clicked => $on_task_list_entry_activated_cb(template);

              styles [
                "circular",
                "suggested-action",
              ]

              ShortcutController {
                scope: global;

                Shortcut {
                  trigger: "<Control>Return";
                  action: "activate";
                }
              }
            }
          }
        };

        sidebar: $ErrandsTaskProperties properties {};
      };
    };

    [overlay]
    Adw.StatusPage loading_page {
      icon-name: "errands-loading-symbolic";
      title: _("Loading Tasks");
      visible: false;

      styles [
        "background",
        "compact",
      ]
    }
  }
}
