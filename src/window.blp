using Gtk 4.0;
using GtkSource 5;
using Adw 1;

template $ErrandsWindow: Adw.ApplicationWindow {
  title: _("Errands");
  default-width: 360;
  default-height: 294;

  Adw.Breakpoint {
    condition ("max-width: 620px")

    setters {
      split_view.collapsed: true;
      split_view.show-content: true;
    }
  }

  Adw.ToastOverlay toast_overlay {
    Adw.NavigationSplitView split_view {
      min-sidebar-width: 250;
      max-sidebar-width: 300;

      sidebar: Adw.NavigationPage {
        title: _("Sidebar");

        child: $ErrandsSidebar sidebar {};
      };

      content: Adw.NavigationPage {
        width-request: 360;
        title: _("Content");

        child: Adw.OverlaySplitView overlay_split_view {
          sidebar-position: end;
          pin-sidebar: true;
          collapsed: true;
          show-sidebar: false;
          min-sidebar-width: 360;
          max-sidebar-width: 500;
          notify::show-sidebar => $on_show_properties_toggled_cb(template);

          content: $ErrandsTaskList task_list {};

          sidebar: Adw.ToolbarView {
            top-bar-style: raised;

            [top]
            Adw.HeaderBar {
              title-widget: Adw.InlineViewSwitcher {
                stack: stack;
                display-mode: both;
              };
            }

            content: Adw.ViewStack stack {
              Adw.ViewStackPage {
                name: "properties";
                title: _("Properties");
                icon-name: "errands-calendar-symbolic";

                child: Adw.PreferencesPage {
                  Adw.PreferencesGroup {
                    title: _("Date and Time");

                    $ErrandsDateChooser start_date_chooser {
                      subtitle: _("Start");
                    }

                    $ErrandsDateChooser due_date_chooser {
                      subtitle: _("Due");
                      visible: bind rrule_row.enable-expansion inverted;
                    }

                    $ErrandsRruleRow rrule_row {}
                  }

                  Adw.PreferencesGroup attachments {
                    title: _("Attachments");
                  }

                  Adw.PreferencesGroup {
                    Adw.ButtonRow {
                      title: _("Add Attachment");
                      start-icon-name: "errands-add-symbolic";
                      action-name: "window.add-attachment";
                    }
                  }

                  Adw.PreferencesGroup tags {
                    title: _("Tags");
                  }

                  Adw.PreferencesGroup {
                    Adw.EntryRow {
                      title: _("New Tag");
                      entry-activated => $on_tag_entry_activated_cb(template);
                    }
                  }
                };
              }

              Adw.ViewStackPage {
                name: "notes";
                title: _("Notes");
                icon-name: "errands-notes-symbolic";

                child: ScrolledWindow {
                  propagate-natural-height: true;
                  vexpand: true;

                  GtkSource.View notes_view {
                    top-margin: 6;
                    bottom-margin: 6;
                    right-margin: 6;
                    left-margin: 6;
                    wrap-mode: word;

                    buffer: GtkSource.Buffer notes_buffer {};
                  }
                };
              }
            };
          };
        };
      };
    }
  }
}
