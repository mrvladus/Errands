# BUILD TARGETS:
#    all                Build the executable into $(BUILD_DIR) (default target)
#    clean              Remove build artifacts
#    install            Install binary, desktop, icons, D-Bus service into $(DESTDIR)$(prefix)
#    uninstall          Remove installed files from $(DESTDIR)$(prefix)
#    run                Build and run the app
#    flatpak-run        Build Flatpak and run it
#    flatpak-bundle     Build Flatpak bundle into $(BUILD_DIR)
#    distrobox-setup    Create/configure the errands-distrobox dev environment
#    nextcloud-setup    Start a Nextcloud Podman container for sync testing
#    sloc               Count lines of code in src/
#    git-commit         Interactive staged-commit helper

# BUILD OPTIONS:
#    prefix  = /usr/local              Installation prefix directory
#    DESTDIR = (not set)               Installation destination directory
#    CFLAGS  = (not set)               Compile flags
#    LDFLAGS = (not set)               Linker flags
#    DEVEL   = FALSE (FALSE|TRUE)      Set development build type
#    DEBUG   = FALSE (GDB|GF2|FALSE)   Run in the debugger


# --- Project info --- #

NAME    = errands
VERSION = 50.0
CC 		= gcc

# --- Project directories --- #

SRC_DIR           = src
DATA_DIR          = data
BUILD_DIR        ?= _build
FLATPAK_BUILD_DIR = _flatpak-build
FLATPAK_REPO_DIR  = _flatpak-repo

# --- Configuration options --- #

DEVEL ?= FALSE
ifeq ($(DEVEL),TRUE)
	APP_ID = io.github.mrvladus.List.Devel
	RESOURCE_PATH = /io/github/mrvladus/Errands/Devel
	ALL_CFLAGS  += -Wall -g -fno-omit-frame-pointer -DCALDAV_DEBUG
	ALL_LDFLAGS +=
else
	APP_ID = io.github.mrvladus.List
	RESOURCE_PATH = /io/github/mrvladus/Errands
	ALL_CFLAGS += -O3 -flto -DG_DISABLE_CAST_CHECKS -DG_DISABLE_CHECKS -DG_DISABLE_ASSERT -fomit-frame-pointer
	ALL_LDFLAGS += -O3 -flto
endif

# --- Installation directories --- #

DESTDIR        ?=
prefix         ?= /usr/local
bindir          = $(prefix)/bin
datarootdir     = $(prefix)/share
localedir       = $(datarootdir)/locale
desktopdir      = $(datarootdir)/applications
dbusdir         = $(datarootdir)/dbus-1/services
icondir         = $(datarootdir)/icons/hicolor
scalableicondir = $(icondir)/scalable/apps
symbolicicondir = $(icondir)/symbolic/apps

# --- Compilation variables --- #

PKG_CONFIG_LIBS = libadwaita-1 \
				  gtksourceview-5 \
				  libsecret-1 \
				  libportal-gtk4 \
				  libedataserver-1.2 \
				  libecal-2.0

LDFLAGS     ?=
ALL_LDFLAGS += $(LDFLAGS) -lm `pkg-config --libs $(PKG_CONFIG_LIBS)`
CFLAGS      ?=
ALL_CFLAGS  += $(CFLAGS) \
			-MMD -MP -std=c11 \
			`pkg-config --cflags $(PKG_CONFIG_LIBS)` \
			-DVERSION='"$(VERSION)"' \
			-DVERSION_COMMIT='"$(shell git rev-parse --short HEAD)"' \
			-DAPP_ID='"$(APP_ID)"' \
			-DRESOURCE_PATH='"$(RESOURCE_PATH)"' \
			-DLOCALE_DIR='"$(localedir)"' \
			-DG_LOG_DOMAIN='"Errands"'

# --- Targets --- #

.PHONY: all
all: $(BUILD_DIR)/$(NAME) mo

.PHONY: clean
clean:
	@rm -rf _* core.*

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

# --- Dependency check --- #

DEPS_CHECKED = $(BUILD_DIR)/deps-checked

$(DEPS_CHECKED): Makefile | $(BUILD_DIR)
	@echo "Checking installed libraries with pkg-config..."
	@if ! command -v pkg-config >/dev/null 2>&1; then \
		echo "Error: pkg-config is not installed"; \
		exit 1; \
	fi
	@missing=""; \
	for lib in $(PKG_CONFIG_LIBS); do \
		echo "Checking $$lib"; \
		if ! pkg-config --exists $$lib; then \
			missing="$$missing $$lib"; \
		fi; \
	done; \
	if [ -n "$$missing" ]; then \
		echo "Error: missing required libraries:"; \
		for lib in $$missing; do echo "  - $$lib"; done; \
		echo ""; \
		echo "Install them and run 'make' again"; \
		exit 1; \
	fi
	@echo "All dependencies found"
	@touch $@

# --- Resources targets --- #

BLPS   = $(wildcard $(SRC_DIR)/*.blp)
ICONS  = $(wildcard $(DATA_DIR)/icons/*.svg)
STYLES = $(DATA_DIR)/style.css

GRESOURCE_XML = $(BUILD_DIR)/$(NAME).gresource.xml
RESOURCES_C   = $(BUILD_DIR)/resources.c
RESOURCES_O   = $(BUILD_DIR)/resources.o

$(RESOURCES_O): $(RESOURCES_C) | $(BUILD_DIR)
	@echo "Compiling $<"
	@$(CC) $(ALL_CFLAGS) -c -o $@ $<

$(RESOURCES_C): $(GRESOURCE_XML) $(BLPS) $(STYLES) $(ICONS)
	@echo "Embedding resources into $@"
	@blueprint-compiler batch-compile $(BUILD_DIR) $(SRC_DIR) $(BLPS)
	@glib-compile-resources --generate-source --target=$@ --c-name=$(NAME) $<

# Generate GResource XML file from `data/style.css`, `data/icons/*.svg`, `src/*.blp`.
$(GRESOURCE_XML): $(BLPS) $(STYLES) $(ICONS)
	@echo "Generating $@"
	@echo '<!-- AUTO-GENERATED BY MAKEFILE. DO NOT EDIT. -->' > $@
	@echo '<?xml version="1.0" encoding="UTF-8" ?>' >> $@
	@echo '<gresources>' >> $@
	@echo '  <!-- STYLES -->' >> $@
	@echo '  <gresource prefix="$(RESOURCE_PATH)">' >> $@
	@echo "    <file compressed=\"true\" alias=\"style.css\">$(DATA_DIR)/style.css</file>" >> $@
	@echo '    <file preprocess="xml-stripblanks" compressed="true" alias="shortcuts-dialog.ui">$(BUILD_DIR)/shortcuts-dialog.ui</file>' >> $@
	@echo '  </gresource>' >> $@
	@echo '  <!-- UI -->' >> $@
	@echo '  <gresource prefix="$(RESOURCE_PATH)/ui">' >> $@
	@ls $(SRC_DIR)/*.blp 2>/dev/null | grep -v "shortcuts-dialog.blp" | while read file; do \
	    basename=$$(basename "$$file" .blp); \
	    echo "    <file preprocess=\"xml-stripblanks\" compressed=\"true\" alias=\"$$basename.ui\">$(BUILD_DIR)/$$basename.ui</file>"; \
	done >> $@
	@echo '  </gresource>' >> $@
	@echo '  <!-- ICONS -->' >> $@
	@echo '  <gresource prefix="$(RESOURCE_PATH)/icons/scalable/actions/">' >> $@
	@for file in $(DATA_DIR)/icons/*.svg; do \
		filename=$$(basename "$$file"); \
		echo "    <file preprocess=\"xml-stripblanks\" compressed=\"true\" alias=\"$$filename\">$(DATA_DIR)/icons/$$filename</file>"; \
	done >> $@
	@echo '  </gresource>' >> $@
	@echo '</gresources>' >> $@

# --- Sources targets --- #

SRCS = $(wildcard $(SRC_DIR)/*.c)
OBJS = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SRCS)) $(RESOURCES_O)
DEPS = $(OBJS:.o=.d)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	@echo "Compiling $<"
	@$(CC) $(ALL_CFLAGS) -c -o $@ $<

$(BUILD_DIR)/$(NAME): $(DEPS_CHECKED) $(OBJS)
		@echo "Linking executable $@"
		@$(CC) -o $@ $^ $(ALL_LDFLAGS)

-include $(DEPS)

# --- Installation targets --- #

.PHONY: install
install: $(BUILD_DIR)/$(NAME)
	# Executable
	install -Dm 755 $(BUILD_DIR)/$(NAME) $(DESTDIR)$(bindir)/$(NAME)
	# Desktop file
	@cp $(DATA_DIR)/$(NAME).desktop.in $(BUILD_DIR)/$(APP_ID).desktop
	@sed -i "s/@APP_ID@/$(APP_ID)/g" $(BUILD_DIR)/$(APP_ID).desktop
	@sed -i "s|@BIN_DIR@|$(bindir)|g" $(BUILD_DIR)/$(APP_ID).desktop
	install -Dm 644 $(BUILD_DIR)/$(APP_ID).desktop $(DESTDIR)$(desktopdir)/$(APP_ID).desktop
	# Icons
	install -Dm 644 $(DATA_DIR)/icons/$(APP_ID).svg $(DESTDIR)$(scalableicondir)/$(APP_ID).svg
	install -Dm 644 $(DATA_DIR)/icons/io.github.mrvladus.List-symbolic.svg $(DESTDIR)$(symbolicicondir)/io.github.mrvladus.List-symbolic.svg
	# D-Bus service
	@cp $(DATA_DIR)/$(NAME).service.in $(BUILD_DIR)/$(APP_ID).service
	@sed -i "s/@APP_ID@/$(APP_ID)/g" $(BUILD_DIR)/$(APP_ID).service
	@sed -i "s|@BIN_DIR@|$(bindir)|g" $(BUILD_DIR)/$(APP_ID).service
	install -Dm 644 $(BUILD_DIR)/$(APP_ID).service $(DESTDIR)$(dbusdir)/$(APP_ID).service
	# Locales
	@for lang in $(LINGUAS); do \
		install -Dm 644 $(BUILD_DIR)/locale/$$lang/LC_MESSAGES/$(NAME).mo \
			$(DESTDIR)$(localedir)/$$lang/LC_MESSAGES/$(NAME).mo; \
	done

.PHONY: uninstall
uninstall:
	rm -f $(DESTDIR)$(bindir)/$(NAME)
	rm -f $(DESTDIR)$(desktopdir)/$(APP_ID).desktop
	rm -f $(DESTDIR)$(scalableicondir)/$(APP_ID).svg
	rm -f $(DESTDIR)$(symbolicicondir)/io.github.mrvladus.List-symbolic.svg
	rm -f $(DESTDIR)$(dbusdir)/$(APP_ID).service
	@for lang in $(LINGUAS); do \
		rm -f $(DESTDIR)$(localedir)/$$lang/LC_MESSAGES/$(NAME).mo; \
	done

# --- Run targets --- #

DEBUG ?= FALSE
ifeq ($(DEBUG),GDB)
    RUN_CMD = gdb -q -ex run $(BUILD_DIR)/$(NAME)
else ifeq ($(DEBUG),GF2)
    RUN_CMD = gf2 $(BUILD_DIR)/$(NAME)
else
	RUN_CMD = $(BUILD_DIR)/$(NAME)
endif

# Build and run the application.
.PHONY: run
run: all
	$(RUN_CMD)

# --- Flatpak targets --- #

$(FLATPAK_BUILD_DIR): $(OBJS)
	flatpak-builder --ccache --force-clean --repo=$(FLATPAK_REPO_DIR) $@ tools/flatpak/$(APP_ID).json

.PHONY: flatpak-run
flatpak-run: $(FLATPAK_BUILD_DIR)
	flatpak-builder --run $< tools/flatpak/$(APP_ID).json $(NAME)

.PHONY: flatpak-bundle
flatpak-bundle: $(FLATPAK_BUILD_DIR) | $(BUILD_DIR)
	flatpak build-bundle $(FLATPAK_REPO_DIR) $(BUILD_DIR)/$(APP_ID).flatpak $(APP_ID) --runtime-repo=https://flathub.org/repo/flathub.flatpakrepo

# --- Development targets --- #

# Setup distrobox environment.
.PHONY: distrobox-setup
distrobox-setup:
	@if ! command -v distrobox >/dev/null 2>&1; then \
		wget -qO- https://raw.githubusercontent.com/89luca89/distrobox/main/install | sh -s -- --prefix ~/.local; \
	fi
	distrobox-rm errands-distrobox --force
	distrobox-create --name errands-distrobox --image archlinux:latest --additional-packages \
    "nano gcc make meson cmake gdb pkgconf git neovim zed curl glib2-devel libadwaita libportal-gtk4 libical libsecret gtksourceview5 blueprint-compiler clang flatpak-builder noto-fonts-emoji"
	distrobox-enter errands-distrobox -- distrobox-export --app zeditor

# Setup Nextcloud container for testing sync.
.PHONY: nextcloud-setup
nextcloud-setup:
	@if ! command -v podman >/dev/null 2>&1; then \
		echo "Podman is required to run Nextcloud container"; \
		exit 1; \
	fi
	podman rm nextcloud-errands --force
	podman volume rm nextcloud-errands --force
	podman volume create nextcloud-errands
	podman run --detach \
	  --env NEXTCLOUD_ADMIN_USER=errands \
	  --env NEXTCLOUD_ADMIN_PASSWORD=errands \
	  --env SQLITE_DATABASE=nextcloud \
	  --volume nextcloud-errands:/var/www/html:z \
	  --restart on-failure \
	  --name nextcloud-errands \
	  --publish 8080:80 \
	  docker.io/library/nextcloud:latest
	@echo "Nextcloud container is running on http://localhost:8080"
	@echo "Username: 'errands', Password: 'errands'"

# Count source lines of code.
.PHONY: sloc
sloc:
	@find $(SRC_DIR) -type f \( -name '*.c' -o -name '*.h' -o -name '*.blp' \) -exec wc -l {} +

.PHONY: git-commit
git-commit:
	@bash -c '\
		set -e; \
		echo "Modifications:"; \
		git status --short; \
		echo "Select commit category:"; \
		echo "  0) Fix"; \
		echo "  1) UI"; \
		echo "  2) Sync"; \
		echo "  3) Build"; \
		echo "  4) Translations"; \
		echo "  5) Misc (default)"; \
		read -r -p "Enter category number: " category; \
		case "$$category" in \
		    0) prefix="Fix" ;; \
			1) prefix="UI" ;; \
			2) prefix="Sync" ;; \
			3) prefix="Build" ;; \
			4) prefix="Translations" ;; \
			*) prefix="Misc" ;; \
		esac; \
		echo "Selected category: $$prefix"; \
		read -r -p "Commit message (default: 'Update'): " message; \
		if [[ -z "$$message" ]]; then \
			message="Update"; \
		fi; \
		git add -A; \
		git commit -m "$$prefix: $$message"'


# --- i18n --- #

PO_DIR          = po
POTFILES    	= $(PO_DIR)/POTFILES
POT_FILE        = $(PO_DIR)/$(NAME).pot
LINGUAS         = $(shell sed -e '/^\#/d' -e '/^$$/d' $(PO_DIR)/LINGUAS)
PO_FILES        = $(patsubst %,$(PO_DIR)/%.po,$(LANGUAS))
MO_FILES        = $(patsubst %,$(BUILD_DIR)/locale/%/LC_MESSAGES/$(NAME).mo,$(LINGUAS))
XGETTEXT_FLAGS  = \
	--from-code=UTF-8 \
	--language=C \
	--keyword=_ \
	--keyword=C_:1c,2 \
	--keyword=N_ \
	--add-comments=Translators:

.PHONY: pot
pot:
	@xgettext --files-from=$(POTFILES) \
		--directory=. \
		--output=$(POT_FILE) \
		$(XGETTEXT_FLAGS) \
		--package-name="$(GETTEXT_PACKAGE)"
	@echo "Generated $(POT_FILE)"

.PHONY: update-po
update-po: $(POT_FILE)
	@for lang in $(LINGUAS); do \
		po_file="$(PO_DIR)/$$lang.po"; \
		if [ -f "$$po_file" ]; then \
			echo "Updating existing: $$po_file"; \
			msgmerge --update --backup=none "$$po_file" $(POT_FILE); \
		else \
			echo "Initializing new language: $$po_file"; \
			msginit --no-translator --locale=$$lang --input=$(POT_FILE) --output="$$po_file"; \
		fi \
	done
	@echo "Updated .po files"

.PHONY: mo
mo: $(MO_FILES)

$(BUILD_DIR)/locale/%/LC_MESSAGES/$(NAME).mo: $(PO_DIR)/%.po | $(BUILD_DIR)
	@echo "Compiling localization catalog [$*]"
	@mkdir -p $(dir $@)
	@msgfmt -o $@ $<
